{
  "name": "clearpath-backend",
  "version": "2.0.0",
  "private": true,
  "description": "ClearPath 2.0 API - Express + Dataverse (MBO-Staffing-Model) + SQL Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "import:csv": "tsx src/jobs/importDataverseCsv.ts",
    "import:users": "tsx src/jobs/importTemporaryUsers.ts",
    "validate:csv": "tsx src/jobs/validateDataverseCsvImport.ts",
    "sync:users": "tsx src/jobs/syncUsers.ts",
    "seed:dataverse": "tsx src/jobs/seedReferenceData.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
