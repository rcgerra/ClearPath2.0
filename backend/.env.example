# ---- Server ----
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Serves in-memory sample data instead of Dataverse; never enable in production.
DEMO_MODE=false

# ---- Auth ----
# Generate a strong secret before any non-local use.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
# dev   = temporary directory user picker (local development only)
# entra = Microsoft Entra ID OpenID Connect sign-in
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Server-only Microsoft Graph app credentials; grant User.Read.All application permission and admin consent.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Identity used locally when the app is not behind an Entra ID reverse proxy.
DEV_USER_EMAIL=
# Comma-separated emails that always receive the admin role.
ADMIN_EMAILS=
# Comma-separated emails that receive read-only portfolio visibility.
PORTFOLIO_MANAGER_EMAILS=

# ---- Dataverse (environment: MBO-Staffing-Model) ----
# Environment URL, e.g. https://orgXXXXXXXX.crm.dynamics.com
DATAVERSE_URL=https://<your-org>.crm.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
DATAVERSE_API_VERSION=9.2
# Publisher prefixes used by the linked tables
DATAVERSE_PREFIX_PRIMARY=new
DATAVERSE_PREFIX_SECONDARY=cr714

# ---- SQL Server (optional reporting mirror / star schema) ----
SQL_ENABLED=false
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=ClearPath
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# ---- Planning horizon ----
# 2-digit encoded weekly arrays: positions * 2 chars must stay under the column limit
PLANNING_ARRAY_POSITIONS=1333
